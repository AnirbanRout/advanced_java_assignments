<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:p="http://www.springframework.org/schema/p"
    xmlns:c="http://www.springframework.org/schema/c"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->

    <!-- setter injection -->
    <bean name="userobj" class="com.spring.capgemini.User">

        <property name="id" value="123"></property>
        <property name="name" value="abc"></property>
        <property name="email" value="abc@gmail.com"></property>

    </bean>

    <bean name="emp_bean" class="com.spring.capgemini.Employee">

        <property name="empid" value="1"></property>
        <property name="empname" value="user_name"></property>
        <property name="salary" value="30000"></property>
        <property name="department" ref="dept_bean"></property>

    </bean>

    <bean name="dept_bean" class="com.spring.capgemini.Department">

        <property name="deptid" value="12"></property>
        <property name="deptname" value="analyst"></property>

    </bean>


</beans>